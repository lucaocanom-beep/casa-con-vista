# URL pubblico del sito
NEXT_PUBLIC_SITE_URL=https://casaconvistaportorecanati.it

# SMTP Aruba — invio email (form contatti + guida lead magnet)
# Impostazioni fisse Aruba per caselle email su dominio personalizzato
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=luca@casaconvistaportorecanati.it
SMTP_PASS=la-tua-password-aruba

# MailerLite — automazioni marketing (funnel guida)
# Account MailerLite → Integrations → API → Create new token
MAILERLITE_API_KEY=eyJhbGci...
# ID del gruppo "Guida Porto Recanati": Groups → crea gruppo → copia ID dall'URL
MAILERLITE_GROUP_ID=000000000000

# Airbnb — feed iCal per il calendario disponibilità (sezione #disponibilita)
# Airbnb → Calendario → Disponibilità → Esporta calendario → copia il link .ics
# ATTENZIONE: contiene un token segreto, non condividerlo e non committarlo mai
AIRBNB_ICAL_URL=https://www.airbnb.it/calendar/ical/xxxxxxx.ics?s=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
